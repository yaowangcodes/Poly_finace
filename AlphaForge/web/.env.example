# Copy to .env.local. Never commit configured secrets or tokens.
APP_ORIGIN=http://localhost:3000
# local opens a single-user localhost workspace without sign-in.
# Use oidc for authenticated multi-user hosting.
WEB_AUTH_MODE=local
LOCAL_OWNER_ID=YOUR_STABLE_LOCAL_WORKSPACE_ID
# The OIDC settings below are needed only for WEB_AUTH_MODE=oidc.
AUTH_ISSUER=https://YOUR_OIDC_ISSUER
AUTH_AUDIENCE=YOUR_OIDC_CLIENT_ID
AUTH_JWKS_URL=https://YOUR_OIDC_JWKS_ENDPOINT
OIDC_CLIENT_ID=YOUR_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_SERVER_ONLY_CLIENT_SECRET
# Generate 32 random bytes, base64-encoded. All web replicas use the same key.
SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
AWS_REGION=us-east-1
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/YOUR_EXISTING_RUNTIME_ID
AGENTCORE_QUALIFIER=DEFAULT
# Local development only; use dynamodb and false for multi-instance production.
STORE_DRIVER=file
ALLOW_LOCAL_FILE_STORE=true
DATA_DIR=.data
DYNAMODB_TABLE=YOUR_EXISTING_OR_REVIEWED_WEB_TABLE
# Optional local credential profile. Omit in IAM role environments.
# AWS_PROFILE=YOUR_LOCAL_PROFILE
